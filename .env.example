# Environment Configuration
# Copy this file to .env and fill in your values

# Django Core
SECRET_KEY=your-very-secret-key-change-in-production-use-50-chars-minimum
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (SQLite used by default when DB_NAME is empty)
USE_SQLITE=True
DB_NAME=ecommerce_saas
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Media & Static
MEDIA_URL=/media/
STATIC_URL=/static/

# Application Settings
LOW_STOCK_THRESHOLD=10
CURRENCY_SYMBOL=₹
SITE_NAME=ShopAI SaaS
SITE_DOMAIN=localhost:8000

# ML Settings
ML_MODELS_DIR=ml_models
RECOMMENDATION_COUNT=10
MIN_DATA_FOR_ML=5
